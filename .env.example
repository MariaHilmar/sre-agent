# Copie para .env (gitignored) e preencha com SEUS tokens.
#
# A Fase 0 (health check HTTP) NÃO precisa de nenhum destes — os endpoints
# /health são públicos. Estes tokens entram nas próximas fases, quando os
# adapters consultarem as APIs das plataformas (deploys, logs, advisors).

GITHUB_TOKEN=
RAILWAY_TOKEN=
VERCEL_TOKEN=
SUPABASE_ACCESS_TOKEN=
